{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kotoba",
  "scopeName": "source.kotoba",
  "fileTypes": [
    "kotoba"
  ],
  "patterns": [
    {
      "name": "comment.line.semicolon.kotoba",
      "match": ";.*$"
    },
    {
      "name": "string.quoted.double.kotoba",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.kotoba",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.kotoba",
      "match": "(?<![^\\s()\\[\\]{}\",;'`@^~])[-+]?(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][-+]?[0-9]+)?)(?![^\\s()\\[\\]{}\",;'`@^~])"
    },
    {
      "name": "constant.language.kotoba",
      "match": "(?<![^\\s()\\[\\]{}\",;'`@^~])(?:true|false|nil)(?![^\\s()\\[\\]{}\",;'`@^~])"
    },
    {
      "name": "constant.other.keyword.kotoba",
      "match": "::?[a-zA-Z0-9*+!_'?<>=/.-]+"
    },
    {
      "name": "invalid.illegal.forbidden-head.kotoba",
      "match": "(?<![^\\s()\\[\\]{}\",;'`@^~])(?:alter-var-root|load-string|read-string|ns-resolve|load-file|volatile!|defmacro|send-off|binding|compile|locking|require|resolve|dosync|future|import|agent|load|pmap|send|set!|new|ref|use|var|\\.\\.|\\.)(?![^\\s()\\[\\]{}\",;'`@^~])"
    },
    {
      "name": "keyword.control.kotoba",
      "match": "(?<![^\\s()\\[\\]{}\",;'`@^~])(?:extend-protocol|definterface|defprotocol|extend-type|defrecord|defn|main|def|let|do|if|ns)(?![^\\s()\\[\\]{}\",;'`@^~])"
    },
    {
      "name": "keyword.control.sugar.kotoba",
      "match": "(?<![^\\s()\\[\\]{}\",;'`@^~])(?:portable-string-symbol-values|typed-capability-call|nested-destructuring|inline-fn-callback|interface-contract|record-constructor|protocol-dispatch|extend-protocol|keyword-literal|string-host-arg|vector-literal|data-host-arg|facet-enter!|facet-leave!|extend-type|lazy-empty\\?|lazy-filter|map-literal|set-literal|defdesugar|lazy-first|contains\\?|defmethod|lazy-cons|lazy-rest|option-or|when-some|defmulti|document|lazy-map|observe!|retract!|when-not|assert!|cond->>|dotimes|if-some|some->>|assert|dissoc|filter|fn-ref|if-not|invoke|reduce|reset!|some->|apply|assoc|bytes|catch|condp|count|deref|doseq|match|recur|swap!|throw|as->|atom|conj|disj|drop|eval|keys|loop|peek|take|vals|when|and|get|map|nth|pop|try|do|fn|or)(?![^\\s()\\[\\]{}\",;'`@^~])"
    },
    {
      "name": "support.function.host-op.kotoba",
      "match": "(?<![^\\s()\\[\\]{}\",;'`@^~])(?:kami-move-tagged-toward!|kami-despawn-within!|tls-server-end-point|clipboard-write-str|kami-nearest-tagged|kgraph-get-objects|kami-count-tagged|transport-connect|cc-warc-extract|fs-write-atomic|kgraph-retract!|corpus-publish|keychain-write|kgraph-assert!|nearest-tagged|corpus-append|keychain-read|cc-cdx-query|count-tagged|kgraph-query|spawn-entity|audio-play|http-fetch|kami-spawn|play-sound|sha256-hex|http-post|kami-axis|llm-infer|log-write|fs-write|log-read|tls-open|fs-read|axis)(?![^\\s()\\[\\]{}\",;'`@^~])"
    },
    {
      "name": "support.function.builtin.kotoba",
      "match": "(?<![^\\s()\\[\\]{}\",;'`@^~])(?:kernel-page-fault-recovery-handler-address|kernel-configure-page-fault-recovery|kernel-probe-recoverable-guard-write|kernel-double-fault-handler-address|kernel-configure-double-fault-ist|kernel-page-fault-handler-address|kernel-rt-timer-handler-address|kernel-probe-double-fault|kernel-isr-entry-address|kernel-probe-guard-write|kernel-uefi-alloc-region|unsigned-bit-shift-right|kernel-dequant-dot-q4-k|kernel-dequant-dot-q6-k|kernel-dequant-dot-q8-0|kernel-probe-nx-execute|kernel-probe-text-write|kernel-atomic-add-u32|kernel-atomic-add-u64|kernel-scratch-region|kernel-store-u16-16k|kernel-store-u16-64k|kernel-store-u32-16k|kernel-store-u32-64k|kernel-store-u64-16k|kernel-store-u64-64k|kernel-load-gdt-tss|kernel-load-u16-16k|kernel-load-u16-64k|kernel-load-u32-16k|kernel-load-u32-64k|kernel-load-u64-16k|kernel-load-u64-64k|kernel-store-u16-4k|kernel-store-u32-4k|kernel-store-u64-4k|kernel-store-u8-16k|kernel-store-u8-64k|kernel-system-table|kernel-try-lock-u32|host-i64-roundtrip|kernel-cmpxchg-u32|kernel-cmpxchg-u64|kernel-fence-store|kernel-load-u16-4k|kernel-load-u32-4k|kernel-load-u64-4k|kernel-load-u8-16k|kernel-load-u8-64k|kernel-store-u8-4k|kernel-fence-full|kernel-fence-load|kernel-load-u8-4k|kernel-uefi-call2|kernel-uefi-call4|kernel-uefi-call6|kernel-unlock-u32|kernel-boot-info|kernel-cpuid-eax|kernel-cpuid-ebx|kernel-cpuid-ecx|kernel-cpuid-edx|kernel-store-u16|kernel-store-u32|kernel-store-u64|kernel-subregion|kernel-write-cr0|kernel-write-cr3|kernel-write-cr4|kernel-write-msr|string-substring|bit-shift-right|has-capability\\?|kernel-load-idt|kernel-load-ptr|kernel-load-u16|kernel-load-u32|kernel-load-u64|kernel-read-cr0|kernel-read-cr2|kernel-read-cr3|kernel-read-cr4|kernel-read-msr|kernel-store-u8|kernel-xchg-u32|kernel-xchg-u64|slice-store-u16|slice-store-u32|slice-store-u64|bit-shift-left|kernel-dot-f32|kernel-jump-to|kernel-load-u8|kernel-out-u32|kernel-read-cs|slice-load-u16|slice-load-u32|slice-load-u64|slice-store-u8|alloc-checked|call-indirect|kernel-in-u32|kernel-invlpg|kernel-out-u8|kernel-rdtscp|kernel-swapgs|kernel-xgetbv|kernel-xsetbv|result-status|result-write!|slice-load-u8|string-concat|string-length|kernel-in-u8|kernel-pause|kernel-rdtsc|memory-pages|result-value|slice-length|slice-of-u16|slice-of-u32|slice-of-u64|byte-store!|cap-acquire|mem-byte-at|memory-grow|pair-second|result-err\\?|slice-of-u8|i32-store!|kernel-cli|kernel-hlt|kernel-sti|mem-i32-at|pair-first|result-ok\\?|slice-set!|bytes-len|bytes-ptr|slice-get|slice-sub|keyword\\?|when-let|bit-and|bit-xor|byte-at|f32sqrt|i64ushr|str-len|str-ptr|string=|string\\?|symbol\\?|bit-or|empty\\?|f32div|f32neg|i64and|i64shl|i64shr|i64xor|if-let|second|symbol|alloc|f32<=|f32>=|first|i64or|zero\\?|case|cond|cons|f32\\*|f32\\+|f32-|f32/|f32<|f32=|f32>|i64\\*|i64\\+|i64-|list|neg\\?|not=|pair|pos\\?|quot|rest|->>|dec|f32|i64|inc|max|min|mod|not|rem|->|<=|>=|\\*|\\+|-|/|<|=|>)(?![^\\s()\\[\\]{}\",;'`@^~])"
    },
    {
      "name": "entity.name.function.kotoba",
      "match": "(?<=\\((?:defn|def|defrecord|defprotocol|definterface)\\s)[^\\s()\\[\\]{}]+"
    },
    {
      "name": "punctuation.section.parens.kotoba",
      "match": "[()\\[\\]{}]"
    },
    {
      "name": "variable.other.symbol.kotoba",
      "match": "(?<![^\\s()\\[\\]{}\",;'`@^~])[a-zA-Z*+!_'?<>=-][^\\s()\\[\\]{}\",;'`@^~]*"
    }
  ]
}
