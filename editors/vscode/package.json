{
  "name": "kotoba",
  "displayName": "Kotoba",
  "description": "Syntax highlighting for Kotoba, including the heads the language refuses.",
  "version": "0.1.0",
  "publisher": "kotoba-lang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kotoba-lang/grammar"
  },
  "homepage": "https://kotoba-lang.org/#docs",
  "bugs": {
    "url": "https://github.com/kotoba-lang/grammar/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "kotoba",
    "language",
    "syntax-highlighting",
    "textmate",
    "capability-security"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "kotoba",
        "aliases": [
          "Kotoba",
          "kotoba"
        ],
        "extensions": [
          ".kotoba"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kotoba",
        "scopeName": "source.kotoba",
        "path": "./syntaxes/kotoba.tmLanguage.json"
      }
    ]
  }
}
